# ─── UTLC ERA Backend — переменные окружения ──────────────────────────────────
# Скопируйте файл: cp .env.example .env  и заполните своими значениями.
# .env закоммитен в .gitignore — никогда не пушьте его в git.

# ── Приложение ────────────────────────────────────────────────────────────────
APP_TITLE=UTLC ERA Route Analyzer
APP_VERSION=2.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── База данных PostgreSQL ───────────────────────────────────────────────────
# Для Neon скопируйте connection-параметры из dashboard.
# Пример Neon: DB_HOST=ep-xxx.eu-central-1.aws.neon.tech, DB_USER=neondb_owner
DB_HOST=localhost
DB_PORT=5432
DB_NAME=utlc_era
DB_USER=postgres
DB_PASSWORD=
# Neon требует SSL. Раскомментируйте если БД в облаке:
# DB_SSLMODE=require

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── API-ключ (опционально) ───────────────────────────────────────────────────
API_KEY=

# ── Внешние сервисы (опционально) ────────────────────────────────────────────
FBX_API_KEY=
ERAI_API_KEY=
